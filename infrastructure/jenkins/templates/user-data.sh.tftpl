#!/usr/bin/env bash
set -Eeuo pipefail

exec > >(tee /var/log/jenkins-bootstrap.log | logger -t jenkins-bootstrap -s 2>/dev/console) 2>&1

dnf update -y
dnf install -y docker git jq java-21-amazon-corretto-headless wget

wget -O /etc/yum.repos.d/jenkins.repo https://pkg.jenkins.io/redhat-stable/jenkins.repo
rpm --import https://pkg.jenkins.io/redhat-stable/jenkins.io-2023.key
dnf install -y ${jenkins_package}

systemctl enable --now docker
usermod -aG docker jenkins
systemctl enable --now jenkins

install -d -m 0755 /var/lib/jenkins/bootstrap
date --iso-8601=seconds > /var/lib/jenkins/bootstrap/completed-at
chown -R jenkins:jenkins /var/lib/jenkins/bootstrap
